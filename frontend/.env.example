# Reown AppKit (wallet modal). Allowlist your domains at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=63c736b6c865aacfa3d5ec9d8d15a48a

# Contracts on Hedera testnet (chain 296)
VITE_CHAIN_ID=296
VITE_REGISTRY_ADDRESS=0xd8EE88623fc33942E554A852530d3CeaB15c39d9
VITE_GATES_ADDRESS=0xC20e25084E041A3638Adb713712888262Daa0C9C

# Server only: the attestor/relayer key. Pays all gas. Never prefix with VITE_.
ATTESTOR_PRIVATE_KEY=

# Self Protocol. Public URL of api/self.js; leave empty to offer demo credentials only.
VITE_SELF_ENDPOINT=
VITE_SELF_ENDPOINT_TYPE=staging_https
VITE_SELF_SCOPE=uwi-identity

# Set to false to disable testnet demo credentials.
DEMO_ISSUANCE=true
