# Reown AppKit — get a project id at https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=26fc2c38c6a17ba6503530bb4113029b

# UniversalWebIdentity contract on Hedera testnet (chain 296)
VITE_UWI_CONTRACT_ADDRESS=0xc010C027c557dB20F5A0cE653Cca257A3De24843

# Self Protocol
# Public https URL of the verify function in api/verify.js (Self's relayer calls it,
# so localhost won't work — use your Vercel URL or an ngrok tunnel in development).
VITE_SELF_ENDPOINT=
# staging_https accepts Self's mock passports; use https for real documents.
VITE_SELF_ENDPOINT_TYPE=staging_https
# Must match on frontend and backend, max 31 ASCII chars.
VITE_SELF_SCOPE=uwi-identity
# Show the "simulate verification" option outside of dev. It's always shown
# when VITE_SELF_ENDPOINT is empty, because there's no other way through the flow.
VITE_ALLOW_DEMO_VERIFY=false
